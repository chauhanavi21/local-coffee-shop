# MongoDB Atlas connection string (include database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Auth — use a long random secret in production
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=7d

# Local API port (Render sets PORT automatically — do not override there)
PORT=5000

# Frontend — baked into the Vite build (set on Vercel only)
VITE_API_URL=http://localhost:5000/api

# Backend CORS — set on Render after Vercel deploy
FRONTEND_URL=http://localhost:5173

# Optional: extra allowed origins, comma-separated (e.g. Vercel preview URLs)
# CORS_ORIGINS=https://my-app.vercel.app,https://my-app-git-main.vercel.app

# Allow all *.vercel.app preview deployments (recommended for staging)
ALLOW_VERCEL_PREVIEWS=true
